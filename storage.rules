rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // SITA RAM OPERATING SYSTEM — ZERO-TRUST STORAGE SECURITY RULES (STEP 6E)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isTenantMember(orgId) {
      return isAuthenticated() && (
        request.auth.token.role == 'PlatformAdmin' ||
        request.auth.token.orgId == orgId
      );
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Menu dish assets (publicly readable within tenant, writable by staff)
    match /tenants/{orgId}/menu/{fileName} {
      allow read: if true;
      allow write: if isTenantMember(orgId) && request.resource.size < 5 * 1024 * 1024;
    }

    // Order receipt / delivery proof uploads
    match /tenants/{orgId}/orders/{orderId}/{fileName} {
      allow read: if isTenantMember(orgId);
      allow write: if isTenantMember(orgId) && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
